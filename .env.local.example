# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://ukfpmpxwdlpsjqbxreza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Auth
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Jordan agent proxy (Documents page)
JORDAN_API_URL=https://jordan.srv1518417.hstgr.cloud
JORDAN_WEBHOOK_SECRET=your_webhook_secret_here

# Gmail sending (rosably-mailer service account, domain-wide delegation, gmail.send scope)
# Base64 of the service account JSON key: base64 -w0 key.json
GOOGLE_MAILER_SA_KEY_B64=base64_of_service_account_json_key
# Must be an allowed sender (see src/lib/email/gmail.ts)
GMAIL_SENDER=brian@rosably.com

# Riley discovery (questionnaire draft + brief). RILEY_AGENT_URL is Riley's base URL (also used by agent dispatch).
# RILEY_DISCOVERY_SECRET must equal Riley's RILEY_DISCOVERY_SECRET; unset = discovery calls fail closed (503).
RILEY_AGENT_URL=https://riley.example.com
RILEY_DISCOVERY_SECRET=your_riley_discovery_secret_here
